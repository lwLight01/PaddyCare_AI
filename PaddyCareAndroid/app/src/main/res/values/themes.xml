<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme (default) -->
    <style name="Theme.PaddyCareAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.PaddyCareAI.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#111F0D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0B1A08</item>
    </style>
</resources>
